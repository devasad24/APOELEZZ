                  <span>See on map</span>
                </button>
              </div>
            </section>

            {/* Design and Architecture Section */}
            <section>
              <h2 className="text-2xl md:text-3xl font-bold mb-4">
                Design and Architecture
              </h2>
              <p className="text-gray-300 mb-6">
