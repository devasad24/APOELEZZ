              </p>

              {/* Interior Images */}
              <div className="grid grid-cols-1 md:grid-cols-2 gap-2 h-48 md:h-64">
                {blogDetails?.images?.map((image, ind) => {
                  return (
                    <div
                      key={ind}
                      className="relative overflow-hidden rounded-l-lg"
                    >
                      <Image
                        src={image?.img_url}
                        alt={image?.img_alt}
                        fill
                        className="object-cover"
                      />
                    </div>
                  );
                })}
